Owner --> UC_CreateTripReport
Owner --> UC_UploadTripPhotos
Owner --> UC_ViewTripReports
Owner --> UC_ViewTripReport
Owner --> UC_SubmitVerification
Owner --> UC_UploadVerificationDocs
Owner --> UC_MyVerifications
Owner --> UC_OwnerAnalytics

Admin --> UC_ListBookings
Admin --> UC_GetBooking
Admin --> UC_ConfirmBooking
Admin --> UC_CancelBooking
Admin --> UC_OpenDispute
Admin --> UC_ResolveDispute
Admin --> UC_Refund
Admin --> UC_ListPayments
Admin --> UC_ListVerifications
Admin --> UC_ReviewVerification
Admin --> UC_CreateAnnouncement
Admin --> UC_DeleteAnnouncement
Admin --> UC_CreateCoupon
Admin --> UC_ListCoupons
Admin --> UC_ToggleCoupon
Admin --> UC_DeleteCoupon
Admin --> UC_Analytics
Admin --> UC_OwnerAnalytics
Admin --> UC_AdminBookings
Admin --> UC_AdminCreateBooking
Admin --> UC_AdminCancelBooking
Admin --> UC_BulkCancelBookings
Admin --> UC_ExportBookings
Admin --> UC_AdminVehicles
Admin --> UC_ApproveVehicle
Admin --> UC_RejectVehicle
Admin --> UC_BulkApproveVehicles
Admin --> UC_AdminUpdateVehicle
Admin --> UC_AdminDeleteVehicle
Admin --> UC_ListUsers
Admin --> UC_CreateUser
Admin --> UC_UpdateUser
Admin --> UC_DeactivateUser
Admin --> UC_BlacklistUser
Admin --> UC_UnblacklistUser
Admin --> UC_ListBlacklist
Admin --> UC_AuditLogs
Admin --> UC_GetConfig
Admin --> UC_UpdateConfig
Admin --> UC_AdminListPayments
Admin --> UC_AdminRefund
Admin --> UC_ListDisputes

System --> UC_ExpireHolds
System --> UC_ActivateBookings
System --> UC_CompleteBookings
System --> UC_ArchiveBookings

UC_ViewVehicle .> UC_BookedRanges : <<include>>
UC_CreateBooking .> UC_CheckAvailability : <<include>>
UC_CreateBooking .> UC_FirstTimeDiscount : <<include>>
UC_CreateBooking .> UC_ApplyCoupon : <<include>>
UC_CreateAnnouncement .> UC_BroadcastAnnouncement : <<extend>>

@enduml
